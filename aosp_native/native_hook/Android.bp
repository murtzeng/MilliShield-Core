cc_binary {
    name: "millishield_surface_interceptor",
    srcs: [
        "SurfaceFrameInterceptor.cpp",
        "mock_npu_engine.cpp",
    ],
    shared_libs: [
        "libutils",
        "libcutils",
        "liblog",
        "libgui",
        "libui",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-O3",
        "-fno-rtti",
    ],
    installable: true,
    sub_dir: "millishield",
}
