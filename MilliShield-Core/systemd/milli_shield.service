[Unit]
Description=MilliShield Core Autonomous AI Cyber Defense Engine
After=network.target local-fs.target
DefaultDependencies=no

[Service]
Type=simple
User=root
WorkingDirectory=/root/MilliShield_Core
ExecStart=/root/MilliShield_Core/.venv/bin/python3 -m uvicorn engine.api_server:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=1ms
OOMScoreAdjust=-1000
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/root/MilliShield_Core

[Install]
WantedBy=multi-user.target